# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# The single shared password investors will use to open the demo.
# Change this before every investor meeting; it's a shared secret, not per-user auth.
DEMO_PASSWORD=change-me

# Random long string used to sign the session cookie. Any value works; keep it secret.
SESSION_SECRET=change-me-too

# Port the server listens on locally. Hosting platforms usually override this.
PORT=3000

# Model to use. Opus 4.8 is the strongest reasoning model -- best fit for judgment-heavy
# tasks like screening and business-plan writing. Swap to claude-sonnet-5 if you want
# faster/cheaper responses, e.g. while doing rapid back-to-back testing.
CLAUDE_MODEL=claude-opus-4-8

# Max web searches per engine. These are intentionally different:
# Ideate is a fast, exploratory pass (mild screening); Validate is the deep,
# rigorous research pass; Plan needs enough budget to ground a full document.
IDEATE_MAX_SEARCHES=4
VALIDATE_MAX_SEARCHES=10
PLAN_MAX_SEARCHES=8
